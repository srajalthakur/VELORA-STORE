DATABASE_URL="postgresql://user:password@localhost:5432/velora"
# Razorpay TEST keys: Dashboard > Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same value in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=""
# Used only by `npm run db:seed` to create the first admin
ADMIN_EMAIL="admin@velora.example"
ADMIN_PASSWORD=""

# --- Needed in production (the app refuses to send emails without them) ---
# Public address of the site, used inside emailed links, e.g. https://velora.example
APP_URL=""
# Email sending through Resend (resend.com). MAIL_FROM must be an address on a domain you verified there.
RESEND_API_KEY=""
MAIL_FROM=""
# How many proxies sit in front of the app (Vercel, Cloudflare Tunnel, one Nginx = 1). Used for rate limits; 0 treats all visitors as one.
TRUSTED_PROXY_HOPS="0"

# Shared store for rate limits (upstash.com > Redis > REST API). Needed once the site runs on more than one server, which is always the case on Vercel.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
